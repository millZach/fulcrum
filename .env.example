# Replay mode runs without credentials.
FULCRUM_PROVIDER_MODE=replay
FULCRUM_ASSET_PROVIDER=meshy
FULCRUM_ORCHESTRATOR_PORT=4310
FULCRUM_WORKSPACE_ROOT=workspace

# Leave these unset to prefer a signed-in OpenAI subscription and fall back to
# the OpenAI API. Set either value to override the automatic route.
# FULCRUM_ORCHESTRATOR_PROVIDER=openai
# FULCRUM_IMPLEMENTATION_PROVIDER=openai
# Leave unset to prefer Codex ImageGen, then fall back to the OpenAI API.
# FULCRUM_IMAGE_PROVIDER=openai-subscription

# Live M0 can use a signed-in Claude, Codex, Grok, or OpenCode client selected
# in Studio. Subscription credentials remain in those clients, never in .env.
# If no OpenAI subscription is available, the automatic fallback needs these.
OPENAI_API_KEY=
# Optional override; defaults to the balanced gpt-5.6-terra route.
# FULCRUM_OPENAI_API_MODEL=gpt-5.6-terra
MESHY_API_KEY=
FULCRUM_MESHY_MODEL=meshy-6
TRIPO_API_KEY=
FULCRUM_TRIPO_MODEL_VERSION=
FULCRUM_M0_BUDGET_USD=

# Optional concept-image routes. No image model uses Fulcrum's procedural
# concept renderer. GPT Image 2 can share OPENAI_API_KEY with text execution.
FULCRUM_IMAGE_API_URL=
FULCRUM_IMAGE_API_KEY=
FULCRUM_IMAGE_API_MODEL=

# Conservative internal reservations; tune to the connected accounts.
FULCRUM_OPENAI_TEXT_RESERVE_USD=0.25
FULCRUM_OPENAI_IMAGE_RESERVE_USD=0.25
FULCRUM_IMAGE_API_RESERVE_USD=0.25
FULCRUM_MESHY_RESERVE_USD=0.50
FULCRUM_TRIPO_RESERVE_USD=0.50
