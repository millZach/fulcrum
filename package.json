{
  "name": "fulcrum",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "concurrently -n orchestrator,studio -c cyan,magenta \"pnpm --filter @fulcrum/orchestrator dev\" \"pnpm --filter @fulcrum/studio dev\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "latest",
    "concurrently": "latest",
    "prettier": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
